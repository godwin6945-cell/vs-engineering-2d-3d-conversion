# ==========================================
# Sketch2STEP Enterprise Environment Config
# ==========================================

# Environment mode: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# AI & LLM Settings (Anthropic)
# ------------------------------------------
ANTHROPIC_API_KEY=your-api-key-here
EXTRACT_MODEL=claude-opus-5-5
CODEGEN_MODEL=claude-sonnet-5-5
# Enable BYOK (Bring Your Own Key) capability
ALLOW_TENANT_BYOK=true

# Database (PostgreSQL 16 with RLS)
# ------------------------------------------
POSTGRES_USER=sketch2step_admin
POSTGRES_PASSWORD=sketch2step_secure_dev_pw
POSTGRES_DB=sketch2step_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sketch2step_admin:sketch2step_secure_dev_pw@localhost:5432/sketch2step_db
DATABASE_SYNC_URL=postgresql://sketch2step_admin:sketch2step_secure_dev_pw@localhost:5432/sketch2step_db

# Redis 7 (Caching & ARQ Task Queue)
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO in dev / S3 or R2 in prod)
# ------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=sketch2step-drawings
S3_REGION=us-east-1
S3_SECURE=false

# Authentication & Security
# ------------------------------------------
# Secret key used for JWT signing and session management (generate with `openssl rand -hex 32`)
SECRET_KEY=sketch2step_super_secret_development_key_change_in_production_32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Master encryption key for BYOK tenant API keys (32 bytes AES-GCM)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Multi-tenancy & Roles
# ------------------------------------------
DEFAULT_ORG_NAME="Alpha Precision Engineering"
ENFORCE_RLS=true

# Billing & Payments (Razorpay India / INR default)
# ------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
DEFAULT_CURRENCY=INR

# Worker & Sandbox Limits
# ------------------------------------------
CAD_SANDBOX_TIMEOUT_SECONDS=45
CAD_SANDBOX_MAX_MEMORY_MB=1024
CAD_SANDBOX_IMAGE=sketch2step-cad-sandbox:latest

# Web & API Ports
# ------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
